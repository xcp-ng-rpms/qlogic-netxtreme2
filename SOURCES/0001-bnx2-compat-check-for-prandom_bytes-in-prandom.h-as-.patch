From 9538f3dabc1b79763a784e3f02f2999dfa314f1a Mon Sep 17 00:00:00 2001
From: Quentin Casasnovas <quentin.casasnovas@vates.tech>
Date: Tue, 18 Aug 2026 11:57:09 +0200
Subject: [PATCH] bnx2: compat: check for prandom_bytes in prandom.h as well.

df9a9ac7a461 ("random32: move the pseudo-random 32-bit definitions to
prandom.h") moved some definitions from random.h to prandom.h, ajust the
compat layer to check at the right place.

Signed-off-by: Quentin Casasnovas <quentin.casasnovas@vates.tech>
---
 bnx2-2.713.27/src/Makefile | 3 +--
 bnx2x-1.715.8/src/Makefile | 2 +-
 2 files changed, 2 insertions(+), 3 deletions(-)

diff --git a/bnx2-2.713.27/src/Makefile b/bnx2-2.713.27/src/Makefile
index 8a9c13aa7bcf..95c365aac645 100755
--- a/bnx2-2.713.27/src/Makefile
+++ b/bnx2-2.713.27/src/Makefile
@@ -248,7 +248,7 @@ ifeq ($(shell grep tcp_v6_check $(LINUXSRC)/include/net/ip6_checksum.h > /dev/nu
 	BNX2X_EXTRA_CFLAGS += -D_DEFINE_TCP_V6_CHECK_
 endif
 
-ifeq ($(shell grep "prandom_bytes" $(LINUXSRC)/include/linux/random.h > /dev/null 2>&1 && echo prandom_bytes),)
+ifeq ($(shell grep "prandom_bytes" $(LINUXSRC)/include/linux/{p,}random.h > /dev/null 2>&1 && echo prandom_bytes),)
 	BNX2X_EXTRA_CFLAGS += -D_DEFINE_PRANDOM_BYTES_
 endif
 
@@ -507,4 +507,3 @@ endif
 clean:
 	-rm -f bnx2.o bnx2.ko bnx2.mod.c bnx2.mod.o bnx2.4.gz cnic.o cnic.ko cnic.mod.c cnic.mod.o .bnx2.*.cmd .cnic.*.cmd *.markers *.order *.symvers
 	-rm -rf .tmp_versions
-
diff --git a/bnx2x-1.715.8/src/Makefile b/bnx2x-1.715.8/src/Makefile
index a73ea7ce1c1a..a8f2cf073e36 100644
--- a/bnx2x-1.715.8/src/Makefile
+++ b/bnx2x-1.715.8/src/Makefile
@@ -188,7 +188,7 @@ ifeq ($(shell grep tcp_v6_check $(LINUXSRC)/include/net/ip6_checksum.h > /dev/nu
 	override EXTRA_CFLAGS += -D_DEFINE_TCP_V6_CHECK_
 endif
 
-ifeq ($(shell grep "prandom_bytes" $(LINUXSRC)/include/linux/random.h > /dev/null 2>&1 && echo prandom_bytes),)
+ifeq ($(shell grep "prandom_bytes" $(LINUXSRC)/include/linux/{p,}random.h > /dev/null 2>&1 && echo prandom_bytes),)
 	override EXTRA_CFLAGS += -D_DEFINE_PRANDOM_BYTES_
 endif
 
-- 
2.43.0

